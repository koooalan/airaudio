{
  "name": "airaudio",
  "version": "1.1.0",
  "description": "Stream Windows system audio to AirPlay receivers",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "mvp": "tsx mvp/index.ts --device-name \"Stereo Mix (Realtek(R) Audio)\"",
    "mvp:discover": "tsx mvp/discover.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "preview": "electron-vite preview",
    "gen-icon": "node scripts/generate-icon.mjs",
    "gen-ext-icons": "node scripts/generate-ext-icons.mjs",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@basmilius/apple-common": "^0.13.3",
    "@lox-audioserver/node-airplay-sender": "^0.4.7",
    "@stablelib/chacha20poly1305": "^2.0.1",
    "bonjour-service": "^1.3.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.1.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.0",
    "patch-package": "^8.0.1",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.1"
  }
}
